+/* ---------------------------------------------------------------------------
+ * remote_bitbang backend.
+ *
+ * Speaks OpenOCD's remote_bitbang protocol over TCP to tools/rbb_bridge.py,
+ * which forwards to the NUCLEO JTAG adaptor.  One character per action:
+ *   '0'+((tck<<2)|(tms<<1)|tdi)   drive the three pins
+ *   'R'                            sample TDO, replies with '0' or '1'
+ *   'Q'                            quit
+ * Writes are buffered and flushed only when a TDO sample is needed -- the link
+ * is a serial port, and one round trip per TCK would be unusably slow.
+ * ------------------------------------------------------------------------- */
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <arpa/inet.h>
+
+static int   rbb_sock = -1;
+static char  rbb_buf[8192];
+static int   rbb_len = 0;
+
+static void rbb_flush(void)
+{
+	if (rbb_len > 0) { (void) write(rbb_sock, rbb_buf, rbb_len); rbb_len = 0; }
+}
+
+static void rbb_put(char c)
+{
+	if (rbb_len >= (int) sizeof(rbb_buf)) rbb_flush();
+	rbb_buf[rbb_len++] = c;
+}
+
+static int rbb_open(const char *host, int port)
+{
+	struct sockaddr_in a;
+	int one = 1;
+	rbb_sock = socket(AF_INET, SOCK_STREAM, 0);
+	if (rbb_sock < 0) return -1;
+	memset(&a, 0, sizeof(a));
+	a.sin_family = AF_INET;
+	a.sin_port = htons((unsigned short) port);
+	a.sin_addr.s_addr = inet_addr(host);
+	if (connect(rbb_sock, (struct sockaddr *) &a, sizeof(a)) < 0) {
+		close(rbb_sock); rbb_sock = -1; return -1;
+	}
+	setsockopt(rbb_sock, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));
+	return 0;
+}
+
+static void rbb_close(void)
+{
+	if (rbb_sock >= 0) { rbb_put('Q'); rbb_flush(); close(rbb_sock); rbb_sock = -1; }
+}
+
+static int rbb_io(int tms, int tdi, int read_tdo)
+{
+	int tdo = 0;
+	rbb_put((char) ('0' + ((tms ? 2 : 0) | (tdi ? 1 : 0))));   /* TCK low  */
+	if (read_tdo) {
+		char c = 0;
+		int n;
+		rbb_put('R');
+		rbb_flush();
+		do { n = read(rbb_sock, &c, 1); } while (n < 0);
+		tdo = (c == '1') ? 1 : 0;
+	}
+	rbb_put((char) ('0' + 4 + ((tms ? 2 : 0) | (tdi ? 1 : 0)))); /* TCK high */
+	rbb_put((char) ('0' + ((tms ? 2 : 0) | (tdi ? 1 : 0))));     /* TCK low  */
+	return tdo;
+}
+#endif /* LINUX_RBB */
+
